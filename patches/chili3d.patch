diff --git a/packages/web/src/daedalusBridge.ts b/packages/web/src/daedalusBridge.ts
new file mode 100644
index 0000000..152cdb4
--- /dev/null
+++ b/packages/web/src/daedalusBridge.ts
@@ -0,0 +1,312 @@
+// Part of the Chili3d Project, under the AGPL-3.0 License.
+// See LICENSE file in the project root for full license information.
+
+import {
+    DimensionAnnotation,
+    GeometryNode,
+    type IApplication,
+    type IDocument,
+    type INode,
+    Logger,
+    Material,
+    pendingWork,
+    quietFrames,
+    VisualNode,
+    type VisualNode as VisualNodeType,
+    XYZ,
+} from "@chili3d/core";
+
+/**
+ * Daedalus X host bridge. The cockpit embeds this page in an iframe on the same origin and asks,
+ * by postMessage, for the open design as STEP so it can import it as a car design.
+ *
+ *   host -> cad: { type: "daedalus:export" }
+ *   cad -> host: { type: "daedalus:exported", name, parts: [{ name, blob }] } | { ..., error }
+ *
+ * One STEP per part: the kernel's STEP writer drops node names, and the importer needs them
+ * (wheel / front wing / body ...) to split force groups and run the rules.
+ *
+ *   host -> cad: { type: "daedalus:rules", revision, rules: [{ part, state, value, limit, unit, axis }] }
+ *   cad -> host: { type: "daedalus:rulesApplied", revision, coloured, dimensions, missing, unavailable }
+ *
+ * Rule colours are document materials, so they are cleared by restoring each node's original
+ * material id. Dimension annotations are only drawn when the host declares an axis; without a
+ * supported anchor the rule is reported as unavailable instead of guessing an attachment.
+ */
+const RULE_COLOURS: Record<string, number> = {
+    fail_cad: 0xef4444,
+    at_risk: 0xf59e0b,
+    pass_cad_only: 0x22c55e,
+};
+const RULE_STATES = Object.keys(RULE_COLOURS);
+
+export interface RuleMessage {
+    part: string;
+    state: string;
+    value: number | null;
+    limit: number | null;
+    unit: string;
+    axis: "x" | "y" | "z" | null;
+    name?: string;
+}
+
+export function validateRules(raw: unknown): { rules: RuleMessage[] } | { error: string } {
+    if (!Array.isArray(raw) || raw.length > 128) {
+        return { error: "Rules must be a list of at most 128 entries." };
+    }
+    const rules: RuleMessage[] = [];
+    for (const item of raw) {
+        if (
+            !item ||
+            typeof item.part !== "string" ||
+            item.part.length === 0 ||
+            item.part.length > 256 ||
+            !RULE_STATES.includes(item.state) ||
+            (item.axis !== null && item.axis !== undefined && !["x", "y", "z"].includes(item.axis)) ||
+            (item.value !== null && item.value !== undefined && !Number.isFinite(item.value)) ||
+            (item.limit !== null && item.limit !== undefined && !Number.isFinite(item.limit))
+        ) {
+            return { error: "Malformed rule overlay entry." };
+        }
+        rules.push({
+            part: item.part,
+            state: item.state,
+            value: typeof item.value === "number" ? item.value : null,
+            limit: typeof item.limit === "number" ? item.limit : null,
+            unit: typeof item.unit === "string" && item.unit.length <= 16 ? item.unit : "",
+            axis: item.axis ?? null,
+            name: typeof item.name === "string" ? item.name.slice(0, 200) : undefined,
+        });
+    }
+    return { rules };
+}
+
+interface RuleOverlay {
+    materials: Map<string, string>;
+    annotations: INode[];
+    restore: Map<string, string | string[]>;
+}
+
+export function installDaedalusBridge(app: IApplication): void {
+    if (window.parent === window) return;
+    let overlay: RuleOverlay = { materials: new Map(), annotations: [], restore: new Map() };
+    const clearOverlay = (document: IDocument) => {
+        for (const [nodeId, materialId] of overlay.restore) {
+            const node = findNode(document, nodeId);
+            if (node instanceof GeometryNode) node.materialId = materialId;
+        }
+        for (const annotation of overlay.annotations) {
+            annotation.parent?.remove(annotation);
+        }
+        overlay = { materials: new Map(), annotations: [], restore: new Map() };
+    };
+    window.addEventListener("message", async (event: MessageEvent) => {
+        if (event.source !== window.parent || event.origin !== window.location.origin) return;
+        if (event.data?.type === "daedalus:focus") {
+            const focusReply = (body: Record<string, unknown>) =>
+                window.parent.postMessage(
+                    { type: "daedalus:focused", requestId: event.data.requestId, ...body },
+                    window.location.origin,
+                );
+            try {
+                const input = event.data.part ?? event.data.parts;
+                const parts = typeof input === "string" ? [input] : input;
+                if (
+                    !Array.isArray(parts) ||
+                    parts.length > 64 ||
+                    !parts.every((p) => typeof p === "string" && p.length > 0 && p.length <= 256)
+                ) {
+                    return focusReply({
+                        error: "Focus requires a list of named parts (or an empty list for the whole car).",
+                    });
+                }
+                await pendingWork.whenIdle();
+                await quietFrames();
+                const view = app.activeView;
+                if (!view) return focusReply({ error: "No CAD document is open." });
+                const nodes = visualNodes(view.document.modelManager.rootNode);
+                const normalise = (name: string) => name.replace(/[\s_-]+/g, "").toLowerCase();
+                const selected = parts.length
+                    ? nodes.filter((node) => parts.some((part) => normalise(part) === normalise(node.name)))
+                    : [];
+                const missing = parts.filter(
+                    (part) => !selected.some((node) => normalise(part) === normalise(node.name)),
+                );
+                if (parts.length && selected.length === 0) return focusReply({ matched: [], missing });
+                selected.forEach((node) => {
+                    node.visible = true;
+                });
+                view.document.selection.setSelectedNodes(selected, false);
+                view.cameraController.fitContent({
+                    scope: parts.length ? "selection" : "all",
+                    duration: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 500,
+                });
+                view.update();
+                focusReply({ matched: selected.map((node) => node.name), missing });
+            } catch (error) {
+                focusReply({ error: error instanceof Error ? error.message : String(error) });
+            }
+            return;
+        }
+        if (event.data?.type === "daedalus:rules") {
+            const reply = (body: Record<string, unknown>) =>
+                window.parent.postMessage(
+                    { type: "daedalus:rulesApplied", revision: event.data.revision, ...body },
+                    window.location.origin,
+                );
+            try {
+                const parsed = validateRules(event.data.rules);
+                if ("error" in parsed) return reply({ error: parsed.error });
+                const rules = parsed.rules;
+                await pendingWork.whenIdle();
+                const view = app.activeView;
+                if (!view) return reply({ error: "No CAD document is open." });
+                const document = view.document;
+                clearOverlay(document);
+                const nodes = visualNodes(document.modelManager.rootNode);
+                const normalise = (name: string) => name.replace(/[\s_-]+/g, "").toLowerCase();
+                const missing: string[] = [];
+                const unavailable: string[] = [];
+                const coloured: string[] = [];
+                const byNode = new Map<VisualNodeType, RuleMessage>();
+                for (const rule of rules) {
+                    const node = nodes.find((candidate) => normalise(candidate.name) === normalise(rule.part));
+                    if (!node) {
+                        missing.push(rule.part);
+                        continue;
+                    }
+                    const rank = (state: string) => (state === "fail_cad" ? 3 : state === "at_risk" ? 2 : 1);
+                    const previous = byNode.get(node);
+                    if (!previous || rank(rule.state) > rank(previous.state)) byNode.set(node, rule);
+                }
+                for (const [node, rule] of byNode) {
+                    const materialId = materialFor(document, rule.state, overlay);
+                    if (node instanceof GeometryNode) {
+                        if (!overlay.restore.has(node.id)) overlay.restore.set(node.id, node.materialId);
+                        node.materialId = materialId;
+                        coloured.push(node.name);
+                    }
+                    if (rule.axis === null) {
+                        unavailable.push(`${rule.part}: no supported feature axis`);
+                        continue;
+                    }
+                    const annotation = dimensionFor(document, node, rule);
+                    if (annotation) {
+                        document.modelManager.addNode(annotation);
+                        overlay.annotations.push(annotation);
+                    } else {
+                        unavailable.push(`${rule.part}: no bounding box`);
+                    }
+                }
+                view.update();
+                reply({ coloured, dimensions: overlay.annotations.length, missing, unavailable });
+            } catch (error) {
+                reply({ error: error instanceof Error ? error.message : String(error) });
+            }
+            return;
+        }
+        if (event.data?.type === "daedalus:clearRules") {
+            const view = app.activeView;
+            if (view) {
+                clearOverlay(view.document);
+                view.update();
+            }
+            window.parent.postMessage(
+                { type: "daedalus:rulesCleared", revision: event.data.revision },
+                window.location.origin,
+            );
+            return;
+        }
+        if (event.data?.type !== "daedalus:export") return;
+        const reply = (body: Record<string, unknown>) =>
+            window.parent.postMessage({ type: "daedalus:exported", ...body }, window.location.origin);
+        try {
+            const document = app.activeView?.document;
+            if (!document) return reply({ error: "No design is open." });
+            const nodes = visualNodes(document.modelManager.rootNode);
+            if (nodes.length === 0) return reply({ error: "The design is empty." });
+            const parts = [];
+            for (const node of nodes) {
+                const data = await app.dataExchange.export(".step", [node]);
+                if (!data) return reply({ error: `STEP export failed for ${node.name}.` });
+                parts.push({ name: node.name, blob: new Blob(data, { type: "model/step" }) });
+            }
+            reply({ name: document.name, parts });
+        } catch (err) {
+            Logger.error(err);
+            reply({ error: err instanceof Error ? err.message : String(err) });
+        }
+    });
+    window.parent.postMessage({ type: "daedalus:ready" }, window.location.origin);
+}
+
+function findNode(document: IDocument, id: string): INode | undefined {
+    const stack: INode[] = [];
+    for (let n = document.modelManager.rootNode.firstChild; n; n = n.nextSibling) stack.push(n);
+    while (stack.length) {
+        const node = stack.pop()!;
+        if (node.id === id) return node;
+        for (let c = (node as { firstChild?: INode }).firstChild; c; c = c.nextSibling) {
+            stack.push(c);
+        }
+    }
+    return undefined;
+}
+
+function materialFor(document: IDocument, state: string, overlay: RuleOverlay): string {
+    const existing = overlay.materials.get(state);
+    if (existing) return existing;
+    const material = new Material({
+        document,
+        name: `Daedalus rule · ${state}`,
+        color: RULE_COLOURS[state] ?? 0x94a3b8,
+    });
+    document.modelManager.materials.push(material);
+    overlay.materials.set(state, material.id);
+    return material.id;
+}
+
+/** A real dimension line along the host-declared axis, labelled with the CAD value and limit. */
+function dimensionFor(
+    document: IDocument,
+    node: VisualNodeType,
+    rule: { value: number | null; limit: number | null; unit: string; axis: string | null; name?: string },
+): DimensionAnnotation | null {
+    const box = node.boundingBox();
+    if (!box || rule.axis === null) return null;
+    const axis = rule.axis as "x" | "y" | "z";
+    const start = new XYZ({ x: box.min.x, y: box.min.y, z: box.min.z });
+    const end = new XYZ({ x: box.max.x, y: box.max.y, z: box.max.z });
+    const span = box.max[axis] - box.min[axis];
+    const offset = Math.max(span * 0.12, 1);
+    const text =
+        axis === "z"
+            ? new XYZ({ x: end.x + offset, y: end.y + offset, z: end.z })
+            : new XYZ({ x: end.x, y: end.y, z: end.z + offset });
+    const value = rule.value === null ? "CAD value unavailable" : `${rule.value.toFixed(2)}${rule.unit}`;
+    const limit =
+        rule.limit === null ? "limit not stated" : `limit ${rule.limit.toFixed(2)}${rule.unit}`;
+    return new DimensionAnnotation({
+        document,
+        annotationType: "dimension",
+        name: `Daedalus rule · ${rule.name ?? node.name}`,
+        color: 0x3dd6f0,
+        startPoint: start,
+        endPoint: end,
+        textPoint: text,
+        dimensionType: "linear",
+        textOverride: `${value} / ${limit} · CAD`,
+    });
+}
+
+function visualNodes(root: INode): VisualNode[] {
+    const out: VisualNode[] = [];
+    const walk = (node: INode | undefined) => {
+        for (let n = node; n; n = n.nextSibling) {
+            if (n instanceof VisualNode) out.push(n);
+            else walk((n as { firstChild?: INode }).firstChild);
+        }
+    };
+    walk((root as { firstChild?: INode }).firstChild);
+    return out;
+}
